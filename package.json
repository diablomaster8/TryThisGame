{
  "name": "grove",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:changed": "node tests/tools/test-changed.mjs",
    "probe:world": "node tests/tools/world-probe.cjs",
    "check:bundle": "node tests/tools/bundle-budget.cjs",
    "smoke:kids": "node tests/smoke/learning-grove.smoke.cjs",
    "smoke:kids-offline": "node tests/smoke/kids-offline.cjs",
    "smoke:mobile": "node tests/smoke/mobile-a11y.smoke.cjs",
    "smoke:a11y": "node tests/smoke/a11y.smoke.cjs",
    "test:e2e": "node tests/e2e/run.cjs",
    "test:leaks": "node tests/e2e/leak-cycle.cjs",
    "test:visual": "node tests/e2e/visual.cjs",
    "test:soak": "node tests/e2e/soak.cjs",
    "golden:update": "node tests/e2e/visual.cjs --update",
    "test:watch": "vitest",
    "lint": "eslint . --cache --cache-strategy content --cache-location .cache/eslint/",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "check": "node tests/tools/check-all.mjs"
  },
  "dependencies": {
    "@fontsource/klee-one": "5.3.0",
    "@fontsource/lexend": "5.3.0",
    "@fontsource/noto-sans-hebrew": "5.3.0",
    "@fontsource/noto-sans-jp": "5.3.0",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.6.5",
    "@types/three": "0.186.0",
    "axe-core": "4.14.0",
    "eslint": "10.12.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vite": "8.3.4",
    "vitest": "5.0.4"
  }
}
