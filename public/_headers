# R0516 TECH-74: security headers for hosts that read this file (Netlify, Cloudflare Pages).
# GitHub Pages ignores it and runs on the <meta> policy in index.html alone; keep the two
# policies the same, plus frame-ancestors, which only works as a header.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self'; worker-src 'self'; connect-src 'self'; img-src 'self' data: blob:; media-src 'self' blob:; font-src 'self'; style-src 'self' 'unsafe-inline'; object-src 'none'; base-uri 'self'; form-action 'none'; frame-ancestors 'none'
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: no-referrer
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  Cross-Origin-Opener-Policy: same-origin

/sw.js
  Cache-Control: no-cache
